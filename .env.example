# Canonical site origin used for metadata, sitemap, robots and structured data (no trailing slash).
# Optional on Vercel: defaults to the project's production domain.
NEXT_PUBLIC_SITE_URL=

# HTTPS endpoint that receives enquiry-form submissions as JSON (CRM, form service or email relay).
# Required for delivery in development and production. Success is shown only after the endpoint
# accepts the submission. Set this in Vercel's Production environment and redeploy.
CONTACT_WEBHOOK_URL=
